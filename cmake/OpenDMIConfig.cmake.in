# Provided targets:
#
#   OpenDMI::shared  - shared library
#   OpenDMI::static  - static library
#   OpenDMI::opendmi - default library (shared)
#
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@LIBOPENDMI_WITH_ICU@)
    find_dependency(ICU COMPONENTS uc)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/OpenDMITargets.cmake")

if(NOT TARGET OpenDMI::opendmi)
    add_library(OpenDMI::opendmi INTERFACE IMPORTED)
    target_link_libraries(OpenDMI::opendmi INTERFACE OpenDMI::shared)
endif()

check_required_components(OpenDMI)
